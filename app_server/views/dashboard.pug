extends layout
include _includes/sharedHTMLfunctions

block content
  //-
    I used the www.pughtml.com site to convert HTML I wrote into Pug.
    To help learn Bootstrap I searched the MTU library and used a beginners tutorial:
    Svekis, L. (2018) Bootstrap 4 for Beginners - Build 5 Websites from Scratch. Packt Publishing.
    Accessed via ProQuest: https://www.proquest.com/docview/2223945055

  .row.banner

    .col-12

      h1
        i.fa.fa-plane
        | #{pageHeader.title}
        small= pageHeader.code
      p.lead= pageHeader.strapline 

  .row

    .col-12.col-lg-9

      .card
      
        .card-header
          i.fa.fa-plane
          | Departures

        table.table

          thead
            tr
              th
              th Flight
              th To
              th Time
              th Gate
              th Status

          tbody
            each flight in departures 

              tr 

                td 

                  +outputStar(flight.starred)

                td 
                
                  a(href='/')= flight.flight
                td= flight.place 
                td= flight.time 
                td= flight.gate 
                td
                  span(class="badge bg-" + flight.colour)= flight.status


      .card
      
        .card-header
          i.fa.fa-plane
          | Arrivals

        table.table

          thead
          
            tr 
              th 
              th Flight 
              th From 
              th Time 
              th Term 
              th Status 
            
          tbody 

            each flight in arrivals 

              tr 

                td 

                  +outputStar(flight.starred)

                td 

                  a(href="/")= flight.flight 
                td= flight.place 
                td= flight.time 
                td= flight.terminal 
                td 
                  span(class="badge bg-" + flight.colour)= flight.status

    .col-12.col-lg-3

      .card

        .card-header
          i.fa.fa-star
          | My watchlist

        table.table

          tbody

            each flight in watchlist 

              tr 
                td= flight.flight 
                td 
                  span(class="badge bg-" + flight.colour)= flight.status

        .card-body

          a(href="/login") Login
          |  to save your own flights.
